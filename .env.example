NODE_ENV=development
PORT=3008

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=slotify
DB_USER=postgres
# Required. Also used by docker-compose for the Postgres container.
DB_PASSWORD=

# Required. Use random values of 32+ characters. The API and worker refuse to start
# with empty or "change-me" values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

GOOGLE_CLIENT_ID=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional: PROCESS_ROLE=api | worker | all
PROCESS_ROLE=all
